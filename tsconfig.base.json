{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@t3d/core-utils": ["packages/core-utils"],
      "@t3d/db-models": ["packages/db-models"],
      "@t3d/entities": ["packages/entities"],
    },
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  },
  "exclude": ["node_modules", "dist"]
}
