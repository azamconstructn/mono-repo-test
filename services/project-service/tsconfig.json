{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "../../packages/core-utils/swagger-helper.ts", "../../packages/core-utils/zod-with-openai.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/core-utils" },
    { "path": "../../packages/db-models" }
  ]
}
