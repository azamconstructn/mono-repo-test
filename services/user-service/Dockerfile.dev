# Development Dockerfile for user-service
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install dependencies for hot reloading
RUN apk add --no-cache git

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./

# Copy workspace configuration
COPY services/user-service/package*.json ./services/user-service/
COPY packages/core-utils/package*.json ./packages/core-utils/
COPY packages/db-models/package*.json ./packages/db-models/

# Install all dependencies (including dev dependencies)
RUN npm ci

# Copy source code
COPY services/user-service/ ./services/user-service/
COPY packages/ ./packages/

# Expose port
EXPOSE 3000

# Start development server with hot reloading
CMD ["npm", "run", "dev:user"] 