{
  "name": "t3d-api",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:user": "npm run dev --workspace=@t3d/user-service",
    "dev:auth": "npm run dev --workspace=@t3d/auth-service",
    "dev:notification": "npm run dev --workspace=@t3d/notification-service",
    "dev:sample": "npm run dev --workspace=@t3d/sample-service",
    "dev:structure": "npm run dev --workspace=@t3d/structure-service",
    "dev:project": "npm run dev --workspace=@t3d/project-service",
    "build:project": "npm run build -w @t3d/auth-service --include-workspace-deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:user": "jest --selectProjects user-service",
    "test:auth": "jest --selectProjects auth-service",
    "test:notification": "jest --selectProjects notification-service",
    "test:sample": "jest --selectProjects sample-service",
    "test:structure": "jest --selectProjects structure-service",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "clean": "rm -rf dist node_modules packages/*/dist services/*/dist",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "monitoring:up": "docker-compose -f infra/docker-compose.monitoring.yml up -d",
    "monitoring:down": "docker-compose -f infra/docker-compose.monitoring.yml down",
    "monitoring:logs": "docker-compose -f infra/docker-compose.monitoring.yml logs -f"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.5.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@opentelemetry/exporter-jaeger": "1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.202.0",
    "@opentelemetry/instrumentation": "^0.51.0",
    "@opentelemetry/instrumentation-express": "^0.51.0",
    "@opentelemetry/instrumentation-http": "^0.51.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.30.1",
    "@types/multer": "^2.0.0",
    "@types/multer-s3": "^3.0.3",
    "amqplib": "^0.10.3",
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.9.4",
    "prom-client": "^14.2.0",
    "short-unique-id": "^5.3.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.10.0",
    "zod": "^4.0.5"
  }
}